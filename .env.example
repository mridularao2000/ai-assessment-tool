# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./assessment.db

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-sonnet-4-6

# ─── Gmail SMTP ───────────────────────────────────────────────────────────────
# App Password from Google Account → Security → 2-Step Verification →
# App Passwords (16 chars, not the account's regular login password). The
# sending account doesn't need to be a real inbox — a dedicated free Gmail
# account works, since sending and receiving addresses are independent.
GMAIL_ADDRESS=your-sending-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
RESEND_FROM_NAME=AI Assessment System
USER_EMAIL=your_email@example.com

# ─── Resend (migrated away from — kept for rollback only, not read unless
#      GMAIL_ADDRESS/GMAIL_APP_PASSWORD above are both unset) ─────────────────
# RESEND_API_KEY=your-resend-api-key-here
# RESEND_FROM_EMAIL=assessments@yourdomain.com

# ─── Application ──────────────────────────────────────────────────────────────
# Set to your deployed URL in production, e.g. https://ai-assessment.onrender.com
APP_BASE_URL=http://localhost:8000
UPLOADS_DIR=uploads
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SUBMISSION_TOKEN_SECRET=change-me-to-a-random-64-char-hex-secret

# ─── Assessment Scheduling ────────────────────────────────────────────────────
# Assessments are scheduled between these many days after target_completion_date.
# Enforced in AssessmentService._calculate_scheduled_at() (primary)
# and SchedulerService.schedule_assessment_jobs() (secondary guard).
ASSESSMENT_WINDOW_MIN_DAYS=1
ASSESSMENT_WINDOW_MAX_DAYS=3
REMINDER_HOURS_BEFORE=24

# ─── Database bootstrap ────────────────────────────────────────────────────────
# Runs create_all() + prompt-template seeding at app startup — this app has
# no separate migration tool, so this IS the real schema/seed step. Leave
# unset (defaults True) for real deployments. The test suite forces this to
# false itself (tests/conftest.py) — never set it here for that purpose.
# RUN_SCHEMA_BOOTSTRAP=true

# ─── Mastery ──────────────────────────────────────────────────────────────────
MASTERY_THRESHOLD=85.0

# ─── LLM ──────────────────────────────────────────────────────────────────────
LLM_MAX_RETRIES=3

# ─── Transcript (curriculum-upload entries only) ─────────────────────────────
# Primary recipient is USER_EMAIL above — unchanged, sent after every
# grading event. Secondary recipient is intentionally separate: removed
# from the per-event trigger, sent only by the biweekly job below. Leave
# blank to keep that job a no-op until a real secondary address is set.
TRANSCRIPT_SECONDARY_RECIPIENT_EMAIL=
TRANSCRIPT_SECONDARY_INTERVAL_DAYS=14
